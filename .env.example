# Copy to .env (gitignored) for `sbf upload` and `sbf status`.

# The competition's URL (with ?secret_key=... for a private competition).
CODABENCH_COMPETITION=

# Your API token: `uv run sbf token` writes it here (Codabench's pages do not show it).
CODABENCH_TOKEN=

# Optional: the reference-cost cache (default ~/.cache/shockbench-flow).
# SBF_CACHE_DIR=
