# Copy this file to .env and adjust values. .env is gitignored: never commit secrets.
# The `sbf` command line reads it at start (values there replace those of your shell, an empty one too); the
# examples read these variables from your shell.

# Environment mode: "production" or "development". Controls default LOG_LEVEL.
ENV_MODE=development

# Loguru log level (DEBUG, INFO, WARNING, ERROR, ...). Defaults to INFO in
# production and DEBUG otherwise.
LOG_LEVEL=INFO

# Emit logs as JSON instead of human-readable lines ("true"/"false").
JSON_LOGS=false

# Colorize console log output ("true"/"false").
COLORIZE=true

# Where the benchmark caches the naive rule's model and the reference costs (default ~/.cache/shockbench-flow).
# SBF_CACHE_DIR=<a directory>

# Codabench, for `sbf upload` and `sbf status` (never printed or stored by the tools).
# Uncomment what you use. Either your API token, or your username (or email) and password. An account created
# with "Sign in with GitHub" has no password until you set one (Codabench's password reset).
# CODABENCH_TOKEN=<your API token>
# CODABENCH_USERNAME=<your username or email>
# CODABENCH_PASSWORD=<your password>
# The competition's id or URL (a URL names the server too), from the competition page.
# CODABENCH_COMPETITION=<the competition's URL>
# Only for a Codabench server other than www.codabench.org.
# CODABENCH_URL=<the server's URL>
